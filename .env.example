# ==============================================================================
# BRTS-Pulse: Environment Configuration & API Keys
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. MAP ENGINE API KEYS (Choose one or use built-in free CartoDB/OSM tiles)
# ------------------------------------------------------------------------------

# Option A: Mapbox Access Token (Mapbox GL JS Vector Tiles)
# Get your free token at https://account.mapbox.com/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VybmFtZSIsImEiOiJjbHh4eHh4eHh4eHh4eHh4eHh4In0.example

# Option B: Google Maps API Key (JavaScript API with Night Mode JSON Style)
# Get your key at https://console.cloud.google.com/
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyDREco2vfX4WeCcsDi4hz0aG2R03RSYcII

# Option C: Stadia Maps / Alidade Smooth Dark API Key (Watermark-free dark tiles)
# Get your key at https://client.stadiamaps.com/
NEXT_PUBLIC_STADIA_API_KEY=your-stadia-api-key-here

# Option D: Custom Map Tile Template URL (Leaflet / OpenStreetMap / CartoDB)
# Default fallback: https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/dark_all/{z}/{x}/{y}{r}.png

# ------------------------------------------------------------------------------
# 2. REAL-TIME HARDWARE GPS & GTFS-RT TRACKING API KEYS
# ------------------------------------------------------------------------------

# Real-time WebSocket or REST endpoint for live bus GPS trackers (e.g. AIS-140 devices / Traccar / Teltonika)
NEXT_PUBLIC_GPS_WEBSOCKET_URL=wss://api.transit.example.com/v1/live-gps

# Real-time GTFS-RT Vehicle Positions Feed URL (e.g. Ahmedabad Janmarg / Delhi Transit API)
GTFS_RT_FEED_URL=https://api.opendata.ahmedabad.gov.in/v1/brts/vehicle-positions
GTFS_RT_API_KEY=your_open_data_api_key_here
